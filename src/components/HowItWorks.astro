---
// src/components/HowItWorks.astro
export interface Props {
  t: any;
  lang: string;
}
const { t, lang } = Astro.props;
---
<section class="bg-blue-700 text-white py-20 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-16">{t.howItWorks.headline}</h2>
    <div class="grid md:grid-cols-3 gap-10 mb-12">
      {t.howItWorks.steps.map((step: any, i: number) => (
        <div class="flex flex-col items-center">
          <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center text-3xl mb-4">
            {step.icon}
          </div>
          <div class="w-8 h-8 bg-white text-blue-700 font-bold rounded-full flex items-center justify-center text-sm mb-4">
            {i + 1}
          </div>
          <h3 class="font-bold text-xl mb-2">{step.title}</h3>
          <p class="text-blue-100 text-sm">{step.description}</p>
        </div>
      ))}
    </div>
    <p class="text-blue-200 mb-8">{t.howItWorks.timeline}</p>
    <a
      href={`/${lang}#contact`}
      class="inline-block bg-white text-blue-700 font-bold px-8 py-4 rounded-xl hover:bg-blue-50 transition-colors"
    >
      {t.howItWorks.cta} →
    </a>
  </div>
</section>
