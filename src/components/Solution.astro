---
export interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="bg-white py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {t.solution.headline}
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">{t.solution.intro}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
      {t.solution.points.map((point: string) => (
        <div class="flex items-start gap-3 p-4 bg-green-50 rounded-lg">
          <span class="text-green-600 font-bold text-lg flex-shrink-0">✅</span>
          <p class="text-gray-700">{point}</p>
        </div>
      ))}
    </div>
  </div>
</section>
