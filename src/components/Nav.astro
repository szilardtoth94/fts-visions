---
export interface Props {
  t: any;
  lang: string;
}

const { t, lang } = Astro.props;
const langs = ['ro', 'hu', 'en'];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white shadow-sm">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href={`/${lang}`} class="flex items-center">
      <img src="/images/logo.svg" alt="FTS Visions" width="128" height="32" class="h-8" />
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
      <a href={`/${lang}#services`} class="hover:text-blue-600 transition-colors">{t.nav.services}</a>
      <a href={`/${lang}#portfolio`} class="hover:text-blue-600 transition-colors">{t.nav.portfolio}</a>
      <a href={`/${lang}#about`} class="hover:text-blue-600 transition-colors">{t.nav.about}</a>
      <a href={`/${lang}#contact`} class="hover:text-blue-600 transition-colors">{t.nav.contact}</a>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex gap-1 text-xs font-semibold">
        {langs.map(l => (
          <a
            href={`/${l}`}
            class={`px-2 py-1 rounded ${lang === l ? 'bg-blue-600 text-white' : 'text-gray-500 hover:text-blue-600'}`}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <a
        href={`/${lang}#contact`}
        class="hidden md:block bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors"
      >
        {t.nav.cta} →
      </a>
    </div>
  </div>
</nav>
<div class="h-16"></div>
