---
// src/components/Footer.astro
export interface Props {
  t: any;
  lang: string;
}
const { t, lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="bg-gray-900 text-white py-10 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <img src="/images/logo.svg" alt="FTS Visions" class="h-8 mx-auto mb-4" />
    <p class="text-gray-400 text-sm mb-2">© {year} FTS Visions — {t.footer.tagline}</p>
    <p class="text-gray-500 text-xs">{t.footer.languages}</p>
    <div class="flex justify-center gap-4 mt-4 text-xs text-gray-500">
      <a href={`/ro`} class={`hover:text-white ${lang === 'ro' ? 'text-white' : ''}`}>RO</a>
      <a href={`/hu`} class={`hover:text-white ${lang === 'hu' ? 'text-white' : ''}`}>HU</a>
      <a href={`/en`} class={`hover:text-white ${lang === 'en' ? 'text-white' : ''}`}>EN</a>
    </div>
  </div>
</footer>
