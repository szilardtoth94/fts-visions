---
// src/components/Portfolio.astro
export interface Props {
  t: any;
}
const { t } = Astro.props;
const previewImages = ['/images/portfolio-wedding.webp', '/images/portfolio-language-teacher.webp'];
---
<section class="bg-white py-20 px-4" id="portfolio">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.portfolio.headline}</h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">{t.portfolio.subheadline}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {t.portfolio.sites.map((site: any, i: number) => (
        <div class={`rounded-2xl overflow-hidden border border-gray-100 shadow-sm flex flex-col ${i === 2 ? 'bg-blue-50 border-blue-100 border-dashed' : 'bg-white'}`}>
          <div class={`h-48 flex items-center justify-center overflow-hidden ${i === 2 ? 'bg-blue-100' : 'bg-gray-100'}`}>
            {i === 2
              ? <span class="text-5xl">🚀</span>
              : <img src={previewImages[i]} alt={site.title} width="1200" height="655" loading="lazy" class="w-full h-full object-cover object-top" />
            }
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-bold text-gray-900 text-lg mb-2">{site.title}</h3>
            <p class="text-gray-600 text-sm mb-4 flex-1">{site.description}</p>
            <a
              href={site.url}
              {...i !== 2 ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
              class={`text-center py-2 px-4 rounded-lg text-sm font-semibold transition-colors ${i === 2 ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
            >
              {site.cta} →
            </a>
          </div>
        </div>
      ))}
    </div>
    <p class="text-center text-gray-600 text-sm max-w-2xl mx-auto">{t.portfolio.tagline}</p>
  </div>
</section>
