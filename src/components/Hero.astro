---
// src/components/Hero.astro
export interface Props {
  t: any;
  lang: string;
}
const { t, lang } = Astro.props;
---
<section class="min-h-screen relative flex items-center text-white px-4">
  <picture>
    <source srcset="/images/hero-bg.webp" type="image/webp" />
    <img
      src="/images/hero-bg.jpg"
      alt=""
      width="1600"
      height="1067"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </picture>
  <div class="absolute inset-0 bg-gradient-to-br from-blue-900/90 to-blue-700/80"></div>
  <div class="relative max-w-4xl mx-auto text-center py-20">
    <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
      {t.hero.headline}
    </h1>
    <p class="text-xl md:text-2xl text-blue-100 mb-10 max-w-2xl mx-auto">
      {t.hero.subheadline}
    </p>
    <a
      href={`/${lang}#contact`}
      class="inline-block bg-white text-blue-700 font-bold text-lg px-8 py-4 rounded-xl hover:bg-blue-50 transition-colors shadow-lg"
    >
      {t.hero.cta} →
    </a>
  </div>
</section>

