---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Solution from '../../components/Solution.astro';
import Pricing from '../../components/Pricing.astro';
import Portfolio from '../../components/Portfolio.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import t from '../../i18n/hu.json';

const lang = 'hu';
---

<Layout
  title="Egyedi Weboldalak Kisvállalkozásoknak Romániában"
  description="Egyedi weboldalak kis vállalkozásoknak Romániában — már €200-tól. Gyors kivitelezés, rejtett költségek nélkül, éves karbantartással."
  lang={lang}
>
  <Nav t={t} lang={lang} />
  <Hero t={t} lang={lang} />
  <Solution t={t} />
  <Pricing t={t} />
  <Portfolio t={t} />
  <HowItWorks t={t} lang={lang} />
  <About t={t} />
  <Contact t={t} />
  <Footer t={t} lang={lang} />
</Layout>
